{
  "name": "skillgap-career-system",
  "version": "1.0.0",
  "private": true,
  "description": "AI-based Skill Gap Analysis and Career Recommendation System",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon --watch backend --ext js,json backend/src/server.js",
    "start": "cross-env NODE_ENV=production node backend/src/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "seed": "node backend/src/seeds/seed.js",
    "esco:extract": "node backend/src/seeds/extractEsco.js",
    "test": "node --test backend/tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "vite": "^5.4.0"
  }
}
