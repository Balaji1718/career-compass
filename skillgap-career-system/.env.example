# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# MongoDB connection string (local or MongoDB Atlas free tier)
# Example: mongodb://127.0.0.1:27017/skillgap_career_db
MONGODB_URI=

# Long random string used to sign the session cookie
SESSION_SECRET=

# Optional AI providers. The app works fully without them.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional AI tuning (defaults shown)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
AI_TIMEOUT_MS=20000

# Optional: directory holding the provided ESCO v1.2.1 CSV files
ESCO_DATA_DIR=./data/esco
