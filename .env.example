# Environment Configuration Template for Career Compass
# Copy to .env and fill in values. Never commit real credentials to version control.

NODE_ENV=development
PORT=3000

# MongoDB Connection (MongoDB Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillgap_career_db
MONGODB_URI=
DB_NAME=skillgap_career_db

# Explicit Fallback Flag:
# When 'false' (default), primary connection failure stops startup with a clear error.
# When 'true' (dev only), falls back to local 127.0.0.1:27017 if primary fails. Never active in production.
ALLOW_LOCAL_MONGO_FALLBACK=false

# Session Security (Generate a secure 64-char random hex string)
SESSION_SECRET=

# AI Provider Configuration (Optional - application functions deterministically without AI)
# OpenRouter Free Router slug (verified dynamic routing to available free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# NVIDIA NIM (Optional fallback; requires active key and supported model)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# AI Request Timeout in milliseconds
AI_TIMEOUT_MS=20000

# ESCO Dataset Source Directory
ESCO_DATA_DIR=./data/esco
